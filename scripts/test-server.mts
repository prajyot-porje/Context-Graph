// Isolated real PostgreSQL and real Next.js. Never reads .env.local or a live DB URL.
import EmbeddedPostgres from "embedded-postgres";
import { mkdtemp, readFile, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { spawn } from "node:child_process";
import { createServer } from "node:http";

const port = Number(process.env.TEST_DATABASE_PORT || 55439);
const dir = await mkdtemp(join(tmpdir(), "contextgraph-test-"));
const pg = new EmbeddedPostgres({
  databaseDir: dir,
  port,
  user: "postgres",
  password: "isolated-test-password",
  persistent: false,
  initdbFlags: ["--encoding=UTF8"],
  onLog: () => {},
  onError: console.error,
});
console.log("Initializing isolated PostgreSQL…");
await pg.initialise();
await pg.start();
console.log("Isolated PostgreSQL ready.");
Object.assign(process.env, {
  SUPABASE_DATABASE_URL: `postgres://postgres:isolated-test-password@127.0.0.1:${port}/postgres`,
  DATABASE_SSL: "false",
  BETTER_AUTH_SECRET: "isolated-test-secret-at-least-thirty-two-characters",
  BETTER_AUTH_URL: "http://127.0.0.1:3100",
  NEXT_PUBLIC_APP_URL: "http://127.0.0.1:3100",
  GOOGLE_CLIENT_ID: "",
  GOOGLE_CLIENT_SECRET: "",
  GEMINI_API_KEY: "",
  OPENROUTER_API_KEY: "test-only",
  OPENROUTER_BASE_URL: "http://127.0.0.1:3101/v1",
  RESEND_API_KEY: "",
  NEXT_PUBLIC_MAINTENANCE_MODE: "false",
  CRON_SECRET: "isolated-test-cron",
  NEXT_PUBLIC_AGENTATION_ENABLED: "false",
});
const { auth } = await import("../lib/auth");
const { getMigrations } = await import("better-auth/db/migration");
const { database } = await import("../lib/database");
const migrations = await getMigrations(auth.options);
const sql = await migrations.compileMigrations();
if (process.argv.includes("--generate-schema"))
  await writeFile(
    "supabase/2026-10-30-auth-schema.sql",
    `-- Generated by Better Auth 1.7.14 against an EMPTY isolated PostgreSQL database.\n-- Fresh installs only. Existing installs: use the additive upgrade script with review.\n${sql}\n`,
  );
await migrations.runMigrations();
let base = await readFile("supabase/schema.sql", "utf8");
base = base.replace(
  /-- ── Realtime[\s\S]*?-- ── Row Level Security/,
  "-- ── Row Level Security",
);
await database.query(base);
await database.query(
  await readFile("supabase/2026-10-30-demo-recovery.sql", "utf8"),
);
await database.query(await readFile("supabase/2026-10-30-oauth.sql", "utf8"));
// Real email signup/verification is exercised with a local capture-only sender below.
// Browser tests can retrieve OTPs from this isolated fixture server, never the app.
const emails = new Map<string, string>();
process.env.EMAIL_API_URL = "http://127.0.0.1:3101/emails";
process.env.RESEND_API_KEY = "fixture-only";
const provider = createServer(async (req, res) => {
  let raw = "";
  for await (const chunk of req) raw += chunk;
  if (req.url === "/emails") {
    const body = JSON.parse(raw);
    const code = String(body.text).match(/code: (\d{6})/)?.[1];
    if (code) emails.set(body.to[0], code);
    res.setHeader("Content-Type", "application/json");
    res.end('{"id":"fixture-email"}');
    return;
  }
  if (req.url?.startsWith("/otp?")) {
    res.setHeader("Content-Type", "application/json");
    res.end(
      JSON.stringify({
        otp: emails.get(
          new URL(req.url, "http://localhost").searchParams.get("email") || "",
        ),
      }),
    );
    return;
  }
  res.setHeader("Content-Type", "application/json");
  const prompt = JSON.parse(raw).messages?.[0]?.content || "";
  const count = Number(prompt.match(/exactly (\d+) objects/)?.[1] || 1);
  res.end(
    JSON.stringify({
      choices: [
        {
          message: {
            content: JSON.stringify(
              Array.from({ length: count }, () => ({
                keep: true,
                kind: "decision",
                entry_text: "fixture judgment",
                target_scope: "me",
                score: 0.8,
              })),
            ),
          },
        },
      ],
    }),
  );
});
await new Promise<void>((resolve) =>
  provider.listen(3101, "127.0.0.1", resolve),
);
if (process.argv.includes("--generate-schema")) {
  await database.end();
  provider.close();
  await pg.stop();
  process.exit(0);
}
const production = process.argv.includes("--production");
if (production) process.env.NEXT_DIST_DIR = ".next-build";
const app = spawn(
  process.execPath,
  [
    "node_modules/next/dist/bin/next",
    production ? "start" : "dev",
    "--hostname",
    "127.0.0.1",
    "--port",
    "3100",
  ],
  { stdio: "inherit", env: process.env, windowsHide: true },
);
let stopping = false;
async function stop() {
  if (stopping) return;
  stopping = true;
  app.kill();
  provider.close();
  await database.end();
  await pg.stop();
  process.exit(0);
}
process.on("SIGINT", stop);
process.on("SIGTERM", stop);
app.on("exit", () => void stop());
