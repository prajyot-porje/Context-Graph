    "@types/pg": "^8.20.0",
    "better-auth": "1.7.14",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "next": "16.4.3",
