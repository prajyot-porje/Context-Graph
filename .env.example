# Copy to .env.local for local app development. Never commit .env.local.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
DATABASE_POOL_MAX=3
# Set false only for an unencrypted loopback development database.
DATABASE_SSL=
# Optional PEM CA from your database provider if its chain is not publicly trusted.
DATABASE_CA_CERT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated personal Gmail sender; use a Google App Password, never the login password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CRON_SECRET=replace-with-a-random-cron-secret
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_AGENTATION_ENABLED=false
# The app's private queries use pg server-side. These legacy Supabase values
# are only needed if another retained integration imports lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
